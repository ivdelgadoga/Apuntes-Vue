
const API_URL = "http://127.0.0.1:8000/api/comunicados";

const obtenerComunicados = async () => {
  try {
    const response = await fetch(API_URL);
    const resultado = await response.json();

    if (!response.ok) {
      throw new Error("Error al consultar la API");
    }

    comunicados.value = resultado.data;
  } catch (error) {
    console.error(error);
  } finally {
    loading.value = false;
  }
};


// Llamada al cargar el componente
onMounted(() => {
  obtenerComunicados();
});
